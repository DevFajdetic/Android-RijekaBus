<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_surface_0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/playerImageContainer"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginHorizontal="40dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true" >

                <ProgressBar
                    android:id="@+id/imageProgressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleX="2"
                    android:scaleY="2"
                    android:layout_gravity="center"
                    android:translationZ="4dp" />

                <ImageView
                    android:id="@+id/ivPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="2dp"
                    android:background="@color/waveALPHA"
                    android:scaleType="centerCrop"
                    android:padding="40dp"
                    tools:src="@drawable/ic_bus_stop_one" />

                <com.example.rijekabusapp.views.NestedViewPager
                    android:id="@+id/imageSliderViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:background="@color/overlay_overlay"
                    android:elevation="2dp" />

                <ImageButton
                    android:id="@+id/btnAddImage"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:color/transparent"
                    android:elevation="2dp"
                    android:src="@drawable/ic_add_photo"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btnEditImage"
                    android:layout_width="36dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="60dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:color/transparent"
                    android:elevation="2dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/white" />

                <me.relex.circleindicator.CircleIndicator
                    android:id="@+id/indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:elevation="2dp" />

            </androidx.cardview.widget.CardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/station_map"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="36dp"
            app:layout_constraintTop_toBottomOf="@id/playerImageContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.example.rijekabusapp.views.MapViewInScroll
                    android:id="@+id/google_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/iv_missing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/neutrals_n_lv_2"
                    android:src="@drawable/ic_missing"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            app:layout_constraintTop_toBottomOf="@id/station_map"
            android:id="@+id/tvAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:text="@string/current_stops"
            android:theme="@style/HeadlineSmallNLv2Left"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            app:layout_constraintTop_toBottomOf="@id/tvAll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible" />

            <com.example.rijekabusapp.views.EmptyStateView
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_station_lines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:itemCount="10"
                tools:listitem="@layout/station_line_item" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>