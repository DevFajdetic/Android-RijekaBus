<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_surface_0"
    tools:context=".LineActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.rijekabusapp.views.MapViewInScroll
                android:id="@+id/google_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <ImageView
                android:id="@+id/iv_missing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_missing"
                android:visibility="gone"
                android:background="@color/neutrals_n_lv_2" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textAppearance="@style/HeadlineSmallNLv2Left"
        android:text="@string/stations" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_gravity="center"
            android:scaleX="2"
            android:scaleY="2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible" />

        <com.example.rijekabusapp.views.EmptyStateView
            android:id="@+id/empty_state"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_line_stations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/line_stations_schedule_item" />

    </FrameLayout>

</LinearLayout>