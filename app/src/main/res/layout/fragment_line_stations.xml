<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_surface_0"
    tools:context=".LineActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginVertical="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.example.rijekabusapp.views.MapViewInScroll
                android:id="@+id/google_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
                
            <ImageView
                android:id="@+id/iv_missing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_missing"
                android:visibility="gone"
                android:background="@color/neutrals_n_lv_2" />
                
            <ImageButton
                android:id="@+id/expand_map_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|bottom"
                android:layout_margin="8dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="@color/white"
                android:contentDescription="@string/map"
                android:elevation="4dp"
                android:padding="12dp"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/color_primary" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Social Features Containers -->
    <include
        android:id="@+id/container_rating"
        layout="@layout/layout_bus_rating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp" />

    <include
        android:id="@+id/container_comments"
        layout="@layout/layout_comments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp" />

    <include
        android:id="@+id/container_chat"
        layout="@layout/layout_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:textAppearance="@style/HeadlineSmallNLv2Left"
        android:text="@string/stations" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_gravity="center"
            android:scaleX="2"
            android:scaleY="2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible" />

        <com.example.rijekabusapp.views.EmptyStateView
            android:id="@+id/empty_state"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_line_stations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/line_stations_schedule_item" />

    </FrameLayout>
</LinearLayout>