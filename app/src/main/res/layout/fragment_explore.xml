<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:theme="@style/Theme.RijekaBusApp"
    tools:context=".fragments.ExploreFragment">

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="@color/color_primary"
        app:itemTextColor="@color/drawer_menu_title_color"
        app:menu="@menu/drawer_body_menu" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/surface_surface_0"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="@color/color_primary"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="1">

                <ImageButton
                    android:id="@+id/ib_menu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_weight="0.15"
                    android:background="@drawable/transparent_background"
                    android:contentDescription="@string/menu"
                    android:scaleX="1.2"
                    android:scaleY="1.2"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_weight="0.35"
                    android:text="Ri"
                    android:textAlignment="textEnd"
                    android:textAppearance="@style/HeadlineLargeNLv1Center"
                    android:textColor="@color/color_quaternary"
                    tools:ignore="RtlCompat" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_weight="0.35"
                    android:text="Bus"
                    android:textAlignment="textStart"
                    android:textAppearance="@style/HeadlineLargeNLv1Center"
                    android:textColor="@color/white"
                    tools:ignore="RtlCompat" />

                <ImageButton
                    android:id="@+id/ib_settings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:layout_weight="0.15"
                    android:background="@drawable/transparent_background"
                    android:contentDescription="@string/settings"
                    android:scaleX="1.2"
                    android:scaleY="1.2"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="70dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/profile_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/profile_details"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/profile_pic_wrapper"
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                app:cardCornerRadius="250dp">

                                <ImageView
                                    android:id="@+id/user_profile_pic"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/user_profile_picture"
                                    android:scaleType="centerCrop"
                                    android:src="@color/wave" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="top|end"
                                android:backgroundTint="@color/color_secondary"
                                android:contentDescription="@string/user_profile_picture"
                                app:cardCornerRadius="250dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/edit"
                                    android:padding="3dp"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_edit"
                                    app:tint="@color/white" />

                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_Hello"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/welcome"
                                android:textAppearance="@style/HeadlineSmallNLv2Left" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/user_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/HeadlineMediumNLv1Left" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/location"
                                android:textAppearance="@style/BodySmallNLv1Left" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="15dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@string/city_icon"
                                android:src="@drawable/ic_city"
                                app:tint="@color/color_tertiary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/color_secondary"
                                android:text="@string/rijeka"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />

                        </LinearLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/weather_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="5dp"
                    app:layout_constraintTop_toBottomOf="@id/profile_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/ll_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/ll_temp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/iv_weather"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center_horizontal"
                                android:contentDescription="@string/weather_icon"
                                android:scaleType="fitXY" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/weather"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_weather"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="center_horizontal"
                                android:layout_gravity="center_horizontal"
                                android:maxWidth="70dp"
                                android:textColor="@color/color_secondary"
                                android:maxLines="3"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/ll_humidity"
                            app:layout_constraintStart_toEndOf="@id/ll_weather"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center_horizontal"
                                android:src="@drawable/ic_temperature"
                                app:tint="@color/color_tertiary"
                                android:contentDescription="@string/temperature" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/temperature"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:textColor="@color/color_secondary"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/ll_temp"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_humidity"
                                app:tint="@color/color_tertiary"
                                android:contentDescription="@string/humidity" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/humidity"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_humidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:textColor="@color/color_secondary"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_wind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/ll_weather"
                            app:layout_constraintStart_toStartOf="@id/ll_weather"
                            app:layout_constraintTop_toBottomOf="@id/ll_weather">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center_horizontal"
                                android:src="@drawable/ic_wind"
                                app:tint="@color/color_tertiary"
                                android:contentDescription="@string/wind" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/wind"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_wind"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:textColor="@color/color_secondary"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_pressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/ll_temp"
                            app:layout_constraintStart_toStartOf="@id/ll_temp"
                            app:layout_constraintTop_toTopOf="@id/ll_wind">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center_horizontal"
                                android:src="@drawable/ic_pressure"
                                app:tint="@color/color_tertiary"
                                android:contentDescription="@string/pressure" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/pressure"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_pressure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:textColor="@color/color_secondary"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_sight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginBottom="16dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/ll_humidity"
                            app:layout_constraintStart_toStartOf="@id/ll_humidity"
                            app:layout_constraintTop_toTopOf="@id/ll_wind">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:layout_gravity="center_horizontal"
                                android:src="@drawable/ic_eye"
                                app:tint="@color/color_tertiary"
                                android:contentDescription="@string/sight" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:text="@string/sight"
                                android:textAppearance="@style/BodyMediumNLv1Left" />

                            <TextView
                                android:id="@+id/tv_sight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:textColor="@color/color_secondary"
                                android:textAppearance="@style/HeadlineSmallNLv1Left" />

                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/news"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/color_secondary_light"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintDimensionRatio="H,4:4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/weather_details">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:text="@string/news"
                        android:textAppearance="@style/HeadlineMediumNLv1Left" />

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom|end"
                        android:src="@drawable/img_news"
                        android:contentDescription="@string/news" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/city_card"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/color_tertiary"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintDimensionRatio="H,4:4"
                    app:layout_constraintStart_toEndOf="@id/news"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/news">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:text="@string/city_card"
                        android:textAppearance="@style/HeadlineMediumNLv1Left" />

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom|end"
                        android:src="@drawable/img_card"
                        android:contentDescription="@string/city_card" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/contact_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/news">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/telefon"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/color_tertiary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="5dp"
                        app:cardUseCompatPadding="false">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_margin="8dp"
                            android:text="@string/telephone"
                            android:textAppearance="@style/HeadlineSmallNLv1Left"
                            android:textColor="@color/white" />

                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical|end"
                            android:contentDescription="@string/telephone_icon"
                            android:src="@drawable/img_telephone" />

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/mail"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="@color/color_tertiary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="5dp"
                        app:cardUseCompatPadding="false">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_margin="8dp"
                            android:text="@string/mail"
                            android:textAppearance="@style/HeadlineSmallNLv1Left"
                            android:textColor="@color/white" />

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical|end"
                            android:src="@drawable/img_mail"
                            android:contentDescription="@string/mail" />

                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/schedules"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/team_spurs_primary"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintDimensionRatio="H,4:4"
                    app:layout_constraintStart_toEndOf="@id/contact_info"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/contact_info">

                    <ImageView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/img_schedule"
                        android:contentDescription="@string/schedules" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:text="@string/schedules"
                        android:textAppearance="@style/HeadlineMediumNLv1Left" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/my_routes"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/pink_alpha"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintDimensionRatio="H,4:4"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/contact_info">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/img_highway"
                        android:contentDescription="@string/my_routes" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:text="@string/my_routes"
                        android:textAppearance="@style/HeadlineMediumNLv1Left" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/maps_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintWidth_percent="0.4"
                    app:layout_constraintStart_toEndOf="@id/my_routes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/schedules">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/prigradska"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/color_tertiary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="5dp"
                        app:cardUseCompatPadding="false">

                        <TextView
                            android:layout_width="match_parent"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_margin="8dp"
                            android:text="@string/outer_city_map"
                            android:textAppearance="@style/HeadlineSmallNLv1Left"
                            android:textColor="@color/white" />

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/gradska"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        app:cardBackgroundColor="@color/color_tertiary"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="5dp"
                        app:cardUseCompatPadding="false">

                        <TextView
                            android:layout_width="match_parent"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|start"
                            android:layout_margin="8dp"
                            android:text="@string/city_map"
                            android:textAppearance="@style/HeadlineSmallNLv1Left"
                            android:textColor="@color/white" />

                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
