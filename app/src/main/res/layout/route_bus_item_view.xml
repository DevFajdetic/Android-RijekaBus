<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/background_bottom_stroke"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/bus_title"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginHorizontal="8dp"
        android:gravity="center"
        android:textAppearance="@style/BodyMediumNLv1Left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/deprature_container"
        app:layout_constraintBottom_toTopOf="@id/iv_mode"
        app:layout_constraintEnd_toStartOf="@id/deprature_container"
        android:text="G-VEZICA TURKOVO - BLA BLA BLA BLA BKDJ" />

    <androidx.cardview.widget.CardView
        android:id="@+id/iv_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/bus_title"
        app:layout_constraintTop_toBottomOf="@id/bus_title"
        app:layout_constraintBottom_toBottomOf="@id/deprature_container"
        app:layout_constraintEnd_toEndOf="@id/bus_title"
        app:cardCornerRadius="15dp"
        app:cardBackgroundColor="@color/color_secondary" >

        <TextView
            android:id="@+id/lineNumber"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/HeadlineMediumOnColorLeft"
            android:text="7" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/deprature_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/no_stops"
        app:layout_constraintStart_toEndOf="@id/bus_title"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:layout_marginVertical="8dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent" >

    <TextView
        android:id="@+id/departue_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_secondary"
        android:text="Departure"
        android:layout_gravity="center"
        android:layout_margin="4dp"
        android:textAppearance="@style/HeadlineSmallNLv1Left" />

    <TextView
        android:id="@+id/dep_station_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="4dp"
        android:text="Brigade 90 bla tusto"
        android:textAppearance="@style/BodyLargeNLv1Left" />

    <TextView
        android:id="@+id/dep_time"
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="4dp"
        android:layout_height="wrap_content"
        android:text="22:10 pm"
        android:textAppearance="@style/HeadlineMediumNLv1Left" />
    </LinearLayout>

    <TextView
        android:id="@+id/no_stops"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ride 6 stops"
        app:layout_constraintEnd_toStartOf="@+id/arrival_container"
        app:layout_constraintStart_toEndOf="@+id/deprature_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textAppearance="@style/HeadlineSmallNLv1Left" />

    <LinearLayout
        android:id="@+id/arrival_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/no_stops"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:layout_marginVertical="8dp"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent" >

        <TextView
            android:layout_gravity="center"
            android:id="@+id/arrival_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:textColor="@color/color_secondary"
            android:text="Arrival"
            android:textAppearance="@style/HeadlineSmallNLv1Left" />

        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_arrive_station"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kumciceva 2 bla te"
            android:ellipsize="end"
            android:layout_margin="4dp"
            android:textAppearance="@style/BodyLargeNLv1Left" />

        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_arrive_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:text="10:35 pm"
            android:textAppearance="@style/HeadlineMediumNLv1Left" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>